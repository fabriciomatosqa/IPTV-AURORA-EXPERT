{
    "name": "electron-backend",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/electron-backend/src",
    "projectType": "application",
    "targets": {
        "verify-data": {
            "executor": "nx:run-commands",
            "options": {
                "command": "node scripts/verify-aurora-data.cjs"
            }
        },
        "build-worker": {
            "executor": "nx:run-commands",
            "outputs": ["{workspaceRoot}/dist/apps/electron-backend/workers"],
            "options": {
                "command": "node apps/electron-backend/build-worker.js"
            }
        },
        "build": {
            "dependsOn": [
                "electron-backend:build-worker",
                {
                    "projects": ["web", "remote-control-web"],
                    "target": "build"
                }
            ],
            "executor": "nx-electron:build",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/apps/electron-backend",
                "main": "apps/electron-backend/src/bootstrap.ts",
                "preload": "apps/electron-backend/src/app/api/main.preload.ts",
                "tsConfig": "apps/electron-backend/tsconfig.app.json",
                "assets": ["apps/electron-backend/src/assets"],
                "buildLibsFromSource": true
            },
            "configurations": {
                "production": {
                    "optimization": true,
                    "extractLicenses": true,
                    "inspect": false,
                    "fileReplacements": [
                        {
                            "replace": "apps/electron-backend/src/environments/environment.ts",
                            "with": "apps/electron-backend/src/environments/environment.prod.ts"
                        }
                    ]
                }
            },
            "defaultConfiguration": "production"
        },
        "serve": {
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    "nx run web:serve",
                    "nx run electron-backend:serve-electron"
                ]
            }
        },
        "serve-electron": {
            "executor": "nx-electron:execute",
            "options": {
                "buildTarget": "electron-backend:build"
            }
        },
        "package": {
            "dependsOn": ["electron-backend:build"],
            "executor": "nx:run-commands",
            "options": {
                "command": "node scripts/package-aurora.cjs --dir"
            }
        },
        "make": {
            "dependsOn": ["electron-backend:build"],
            "executor": "nx:run-commands",
            "options": {
                "command": "node scripts/package-aurora.cjs"
            }
        },
        "make-native": {
            "executor": "nx:run-commands",
            "options": {
                "command": "node scripts/package-aurora.cjs"
            }
        },
        "lint": {
            "command": "eslint apps/electron-backend/**/*.ts"
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
            "options": {
                "jestConfig": "apps/electron-backend/jest.config.ts"
            }
        }
    }
}
